BOT_TOKEN=123456:ABC-your-telegram-bot-token
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uni_bot
# For local development without PostgreSQL you may use:
# DATABASE_URL=sqlite+aiosqlite:///./uni_bot.db
ENCRYPTION_KEY=change-me-generate-a-fernet-key
ECLASS_BASE_URL=https://your-eclass-url.example
DEFAULT_TIMEZONE=Asia/Tashkent

# Only one bot instance may poll a given token. The app enforces this with an
# OS lock at .classmate_ai.lock; set this to relocate that lock file (e.g. when
# two checkouts share one token and you want them to collide loudly instead of
# silently stealing each other's updates).
# CLASSMATE_LOCK_FILE=.classmate_ai.lock
